generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        Int      @id @default(autoincrement())
  titulo    String
  resumo    String
  conteudo  String
  slug      String   @unique
  tipo      String
  urlMidia  String?
  publicado Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NOVO: Tabela para controlar os dados dinâmicos do site
model ConfiguracaoSite {
  id             Int      @id @default(1) // Terá sempre o ID 1
  mensagemHeader String   @default("Bem-vindo à Arthur Felipe Terapias Orientais")
  horarioHeader  String   @default("Seg - Sáb")
  fotoHeroUrl    String?  // Link da imagem principal
  fotoSobreUrl   String?  // Link da imagem da seção Sobre
  updatedAt      DateTime @updatedAt
}